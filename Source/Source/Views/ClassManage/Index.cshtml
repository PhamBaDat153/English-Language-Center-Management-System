
@model IEnumerable<Source.Models.Class>

@{
    ViewBag.Title = "Quản lý lớp học";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalItems = ViewBag.TotalItems ?? 0;
    int pageSize = ViewBag.PageSize ?? 15;

    int firstItem = totalItems == 0
        ? 0
        : ((currentPage - 1) * pageSize) + 1;

    int lastItem = Math.Min(currentPage * pageSize, totalItems);
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-easel2" aria-hidden="true"></i>
                </span>

                <div>
                    <p class="eyebrow mb-1">Trang quản lý</p>
                    <h1 class="h3 mb-1">Lớp học</h1>
                    <p class="text-muted mb-0">
                        Quản lý mã lớp, khóa học, giáo viên, phòng học và lịch học.
                    </p>
                </div>
            </div>

            <div class="heading-actions">
                <a class="btn btn-primary btn-sm"
                   href="@Url.Action("Create", "ClassManage")">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i>
                    Thêm lớp học
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3"
                 role="alert">
                <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3"
                 role="alert">
                <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        <section class="row g-3 mt-1" aria-label="Thống kê lớp học">
            <div class="col-12 col-sm-6 col-xl-3">
                <article class="metric-card metric-primary">
                    <div class="metric-top">
                        <span class="metric-label">Số lớp tìm thấy</span>
                        <span class="metric-icon">
                            <i class="bi bi-easel2" aria-hidden="true"></i>
                        </span>
                    </div>
                    <div class="metric-value">@totalItems</div>
                </article>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <article class="metric-card metric-warning">
                    <div class="metric-top">
                        <span class="metric-label">Trang hiện tại</span>
                        <span class="metric-icon">
                            <i class="bi bi-files" aria-hidden="true"></i>
                        </span>
                    </div>
                    <div class="metric-value">@currentPage / @Math.Max(totalPages, 1)</div>
                </article>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <article class="metric-card metric-success">
                    <div class="metric-top">
                        <span class="metric-label">Số lớp mỗi trang</span>
                        <span class="metric-icon">
                            <i class="bi bi-list-ol" aria-hidden="true"></i>
                        </span>
                    </div>
                    <div class="metric-value">@pageSize</div>
                </article>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <article class="metric-card metric-danger">
                    <div class="metric-top">
                        <span class="metric-label">Trạng thái lọc</span>
                        <span class="metric-icon">
                            <i class="bi bi-funnel" aria-hidden="true"></i>
                        </span>
                    </div>
                    <div class="metric-value fs-5">
                        @(string.IsNullOrWhiteSpace(ViewBag.Status as string)
                            ? "Tất cả"
                            : ViewBag.Status)
                    </div>
                </article>
            </div>
        </section>

        <section class="panel mt-3">
            <h3>Tìm kiếm lớp học</h3>

            <form class="mb-4"
                  method="get"
                  action="@Url.Action("Index", "ClassManage")"
                  aria-label="Lọc lớp học">

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label small fw-semibold"
                               for="classCode">Mã lớp</label>
                        <input class="form-control form-control-sm"
                               id="classCode"
                               name="classCode"
                               type="search"
                               value="@ViewBag.ClassCode"
                               placeholder="Nhập mã lớp" />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label small fw-semibold"
                               for="status">Trạng thái</label>
                        <select class="form-select form-select-sm"
                                id="status" name="status">
                            <option value="">Tất cả trạng thái</option>
                            <option value="Planned"
                                    @(ViewBag.Status as string == "Planned" ? "selected" : "")>
                                Planned - Dự kiến
                            </option>
                            <option value="Open"
                                    @(ViewBag.Status as string == "Open" ? "selected" : "")>
                                Open - Mở đăng ký
                            </option>
                            <option value="InProgress"
                                    @(ViewBag.Status as string == "InProgress" ? "selected" : "")>
                                InProgress - Đang diễn ra
                            </option>
                            <option value="Completed"
                                    @(ViewBag.Status as string == "Completed" ? "selected" : "")>
                                Completed - Hoàn thành
                            </option>
                            <option value="Cancelled"
                                    @(ViewBag.Status as string == "Cancelled" ? "selected" : "")>
                                Cancelled - Đã hủy
                            </option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label small fw-semibold"
                               for="courseId">Khóa học</label>
                        @Html.DropDownList(
                            "courseId",
                            (SelectList)ViewBag.Courses,
                            "Tất cả khóa học",
                            new { @class = "form-select form-select-sm", id = "courseId" })
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <label class="form-label small fw-semibold"
                               for="teacherId">Giáo viên</label>
                        @Html.DropDownList(
                            "teacherId",
                            (SelectList)ViewBag.Teachers,
                            "Tất cả giáo viên",
                            new { @class = "form-select form-select-sm", id = "teacherId" })
                    </div>

                    <div class="col-12 d-flex flex-wrap gap-2">
                        <button class="btn btn-primary btn-sm" type="submit">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            Tìm kiếm
                        </button>

                        <a class="btn btn-outline-secondary btn-sm"
                           href="@Url.Action("Index", "ClassManage")">
                            <i class="bi bi-arrow-counterclockwise"
                               aria-hidden="true"></i>
                            Xóa bộ lọc
                        </a>
                    </div>
                </div>
            </form>

            <div class="panel-header">
                <div>
                    <h2 class="h5 mb-1 section-title">
                        <i class="bi bi-table" aria-hidden="true"></i>
                        <span>Danh sách lớp học</span>
                    </h2>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mã lớp</th>
                            <th>Khóa học</th>
                            <th>Giáo viên</th>
                            <th>Phòng học</th>
                            <th>Ngày bắt đầu</th>
                            <th>Ngày kết thúc</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td class="text-center text-muted py-5" colspan="8">
                                    <i class="bi bi-easel d-block fs-2 mb-2"
                                       aria-hidden="true"></i>
                                    Không tìm thấy lớp học phù hợp.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                    <tr>
                        <td>
                            <strong>@item.class_code</strong>
                        </td>
                        <td>
                            @(item.Course != null
        ? item.Course.course_name
        : "Chưa có khóa học")
                        </td>

                        <td>
                            @(item.Teacher_profile != null
        && item.Teacher_profile.Staff_Profile != null
        && item.Teacher_profile.Staff_Profile.User != null
        ? item.Teacher_profile.Staff_Profile.User.full_name
        : "Chưa phân công")
                        </td>

                        <td>
                            @(item.Room != null
        ? item.Room.room_name
        : "Chưa xếp phòng")
                        </td>
                        <td>@item.start_date.ToString("dd/MM/yyyy")</td>
                        <td>@item.end_date.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            @switch (item.class_status)
                            {
                                case "Planned":
                                    <span class="badge bg-secondary">Dự kiến</span>
                                    break;
                                case "Open":
                                    <span class="badge bg-primary">Mở đăng ký</span>
                                    break;
                                case "InProgress":
                                    <span class="badge bg-success">Đang diễn ra</span>
                                    break;
                                case "Completed":
                                    <span class="badge bg-info text-dark">Hoàn thành</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-danger">Đã hủy</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@item.class_status</span>
                                    break;
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex gap-1">
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@Url.Action("Details", "ClassManage",
                                                   new { id = item.class_id })"
                                   title="Xem và chỉnh sửa">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </a>

                                @using (Html.BeginForm(
"Delete",
"ClassManage",
new { id = item.class_id },
FormMethod.Post,
new
{
@class = "d-inline",
onsubmit = "return confirm('Bạn có chắc chắn muốn xóa lớp học này không?');"
}))
                                {
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn-action btn-delete"
                                            title="Xóa lớp học">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-column flex-sm-row
                        align-items-sm-center justify-content-between
                        gap-3 mt-3">
                <p class="text-muted small mb-0">
                    Hiển thị @firstItem - @lastItem trong tổng số @totalItems lớp học.
                </p>

                @if (totalPages > 1)
                {
                    <nav aria-label="Phân trang lớp học">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Index", new {
                                       page = currentPage - 1,
                                       classCode = ViewBag.ClassCode,
                                       status = ViewBag.Status,
                                       courseId = ViewBag.CourseId,
                                       teacherId = ViewBag.TeacherId
                                   })">Trước</a>
                            </li>

                            @for (int p = 1; p <= totalPages; p++)
                            {
                                <li class="page-item @(p == currentPage ? "active" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new {
                                           page = p,
                                           classCode = ViewBag.ClassCode,
                                           status = ViewBag.Status,
                                           courseId = ViewBag.CourseId,
                                           teacherId = ViewBag.TeacherId
                                       })">@p</a>
                                </li>
                            }

                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Index", new {
                                       page = currentPage + 1,
                                       classCode = ViewBag.ClassCode,
                                       status = ViewBag.Status,
                                       courseId = ViewBag.CourseId,
                                       teacherId = ViewBag.TeacherId
                                   })">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </section>
    </div>
</main>
