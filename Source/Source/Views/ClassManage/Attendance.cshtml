@model Source.ViewModels.ClassAttendanceViewModel
@using System.Linq
@{
    ViewBag.Title = "Điểm danh";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div>
                <p class="eyebrow mb-1">Lớp @Model.class_code</p>
                <h1 class="h3 mb-1">Điểm danh buổi học</h1>
                <p class="text-muted mb-0">@Model.session_date.ToString("dd/MM/yyyy") · @(Model.time_slot_name ?? "-") · @(Model.topic ?? "Chưa có chủ đề")</p>
            </div>
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Details", "ClassManage", new { id = Model.class_id })">Quay lại</a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
        }

        @using (Html.BeginForm("Attendance", "ClassManage", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.session_id)
            <section class="panel mt-3">
                @if (Model.Students == null || !Model.Students.Any())
                {
                    <div class="alert alert-light border mb-0">Không có học sinh đang hoạt động trong buổi học này.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead><tr><th>Mã học sinh</th><th>Họ tên</th><th>Trạng thái</th><th>Ghi chú</th></tr></thead>
                            <tbody>
                            @for (var i = 0; i < Model.Students.Count; i++)
                            {
                                <tr>
                                    <td>@Model.Students[i].student_code</td>
                                    <td>@Model.Students[i].student_name</td>
                                    <td>
                                        @Html.HiddenFor(m => m.Students[i].enrollment_id)
                                        @Html.DropDownListFor(m => m.Students[i].attendance_status, new[] {
                                            new SelectListItem { Text = "-- Chọn trạng thái --", Value = "" },
                                            new SelectListItem { Text = "Có mặt", Value = "Present" },
                                            new SelectListItem { Text = "Vắng", Value = "Absent" },
                                            new SelectListItem { Text = "Có phép", Value = "Excused" }
                                        }, new { @class = "form-select" })
                                    </td>
                                    <td>@Html.TextBoxFor(m => m.Students[i].remarks, new { @class = "form-control", maxlength = "1000" })</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-3"><button type="submit" class="btn btn-primary">Lưu điểm danh</button></div>
                }
            </section>
        }
    </div>
</main>
