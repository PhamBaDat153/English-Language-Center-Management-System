
@model Source.Models.Class

@{
    ViewBag.Title = "Chi tiết lớp học";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-easel2" aria-hidden="true"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1">Quản lý lớp học</p>
                    <h1 class="h3 mb-1">Chi tiết lớp học</h1>
                    <p class="text-muted mb-0">
                        Xem hoặc cập nhật thông tin lớp @Model.class_code.
                    </p>
                </div>
            </div>
            <div class="heading-actions">
                <a class="btn btn-outline-secondary btn-sm"
                   href="@Url.Action("Index", "ClassManage")">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                    Quay lại danh sách
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        <section class="panel mt-3">
            @using (Html.BeginForm("Details", "ClassManage", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.class_id)

                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">ID lớp học</label>
                        <input class="form-control" value="@Model.class_id" readonly />
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.class_code, "Mã lớp",
                            new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.class_code,
                            new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.class_code, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.course_id, "Khóa học",
                            new { @class = "form-label fw-semibold" })
                        @Html.DropDownListFor(m => m.course_id,
                            (SelectList)ViewBag.Courses,
                            "-- Chọn khóa học --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.course_id, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.class_capacity, "Sĩ số tối đa",
                            new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.class_capacity,
                            new { @class = "form-control", type = "number", min = "1" })
                        <div class="form-text">
                            Đang giữ chỗ/đang học: @ViewBag.ActiveEnrollmentCount học viên.
                            Không được vượt quá sức chứa phòng.
                        </div>
                        @Html.ValidationMessageFor(m => m.class_capacity, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.teacher_id, "Giáo viên",
                            new { @class = "form-label fw-semibold" })
                        @Html.DropDownListFor(m => m.teacher_id,
                            (SelectList)ViewBag.Teachers,
                            "-- Chưa phân công --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.teacher_id, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.room_id, "Phòng học",
                            new { @class = "form-label fw-semibold" })
                        @Html.DropDownListFor(m => m.room_id,
                            (SelectList)ViewBag.Rooms,
                            "-- Chưa xếp phòng --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.room_id, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.start_date, "Ngày bắt đầu",
                            new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.start_date, "{0:yyyy-MM-dd}",
                            new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.start_date, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.end_date, "Ngày kết thúc",
                            new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.end_date, "{0:yyyy-MM-dd}",
                            new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.end_date, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.class_status, "Trạng thái",
                            new { @class = "form-label fw-semibold" })
                        @Html.DropDownListFor(m => m.class_status,
                            (SelectList)ViewBag.ClassStatuses,
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.class_status, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Ngày tạo</label>
                        <input class="form-control"
                               value="@Model.created_at.ToString("dd/MM/yyyy HH:mm")"
                               readonly />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold">Cập nhật lần cuối</label>
                        <input class="form-control"
                               value="@Model.updated_at.ToString("dd/MM/yyyy HH:mm")"
                               readonly />
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save" aria-hidden="true"></i>
                        Lưu thay đổi
                    </button>
                    <a class="btn btn-outline-secondary"
                       href="@Url.Action("Index", "ClassManage")">
                        Hủy
                    </a>
                    <a class="btn btn-outline-danger ms-md-auto"
                       href="@Url.Action("Delete", "ClassManage",
                           new { id = Model.class_id })">
                        <i class="bi bi-trash3" aria-hidden="true"></i>
                        Xóa lớp
                    </a>
                </div>
            }
        </section>

        <section class="panel mt-4">
            <div class="mb-3">
                <h2 class="h5 mb-1">Danh sách học sinh</h2>
                <p class="text-muted mb-0">Các học sinh đã đăng ký lớp @Model.class_code.</p>
            </div>

            @using (Html.BeginForm("Details", "ClassManage", FormMethod.Get, new { @class = "row g-2 mb-3" }))
            {
                <input type="hidden" name="id" value="@Model.class_id" />
                <div class="col-12 col-md-4">
                    <label for="studentName" class="form-label visually-hidden">Tên học sinh</label>
                    <input type="text" id="studentName" name="studentName"
                           class="form-control" placeholder="Tên học sinh"
                           value="@(ViewBag.StudentName ?? "")" />
                </div>
                <div class="col-12 col-md-4">
                    <label for="studentEmail" class="form-label visually-hidden">Gmail/email</label>
                    <input type="text" id="studentEmail" name="studentEmail"
                           class="form-control" placeholder="Gmail/email"
                           value="@(ViewBag.StudentEmail ?? "")" />
                </div>
                <div class="col-12 col-md-2">
                    <label for="studentStatus" class="form-label visually-hidden">Trạng thái</label>
                    <select id="studentStatus" name="studentStatus" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Pending" @(ViewBag.StudentStatus == "Pending" ? "selected" : "")>Đang chờ</option>
                        <option value="Confirmed" @(ViewBag.StudentStatus == "Confirmed" ? "selected" : "")>Đã xác nhận</option>
                        <option value="Studying" @(ViewBag.StudentStatus == "Studying" ? "selected" : "")>Đang học</option>
                        <option value="Completed" @(ViewBag.StudentStatus == "Completed" ? "selected" : "")>Hoàn thành</option>
                        <option value="Withdrawn" @(ViewBag.StudentStatus == "Withdrawn" ? "selected" : "")>Đã vô hiệu hóa</option>
                        <option value="Cancelled" @(ViewBag.StudentStatus == "Cancelled" ? "selected" : "")>Đã hủy</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search" aria-hidden="true"></i> Lọc
                    </button>
                    <a class="btn btn-outline-secondary"
                       href="@Url.Action("Details", "ClassManage", new { id = Model.class_id })"
                       title="Xóa bộ lọc" aria-label="Xóa bộ lọc">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </a>
                </div>
            }

            @{
                var classStudents = ViewBag.ClassStudents as IEnumerable<Source.Models.Enrollment>;
            }

            @if (classStudents == null || !classStudents.Any())
            {
                <div class="alert alert-light border mb-0">
                    Lớp chưa có học sinh đăng ký.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mã học sinh</th>
                                <th>Họ và tên</th>
                                <th>Email</th>
                                <th>Số điện thoại</th>
                                <th>Ngày đăng ký</th>
                                <th>Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enrollment in classStudents)
                            {
                                var student = enrollment.Student_Profile;
                                var user = student == null ? null : student.User;
                                <tr>
                                    <td>@(student == null ? "-" : student.student_code)</td>
                                    <td>@(user == null ? "-" : user.full_name)</td>
                                    <td>@(user == null || string.IsNullOrWhiteSpace(user.email) ? "-" : user.email)</td>
                                    <td>@(user == null || string.IsNullOrWhiteSpace(user.phone_number) ? "-" : user.phone_number)</td>
                                    <td>@enrollment.enrollment_date.ToString("dd/MM/yyyy")</td>
                                    <td>@enrollment.enrollment_status</td>
                                    <td class="text-end">
                                        @if (enrollment.enrollment_status == "Withdrawn")
                                        {
                                            using (Html.BeginForm("ReactivateStudent", "ClassManage", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("enrollmentId", enrollment.enrollment_id)
                                                @Html.Hidden("classId", Model.class_id)
                                                <button type="submit" class="btn btn-outline-success btn-sm"
                                                        onclick="return confirm('Bạn có chắc muốn kích hoạt lại học sinh này không?');">
                                                    Kích hoạt lại
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            using (Html.BeginForm("WithdrawStudent", "ClassManage", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("enrollmentId", enrollment.enrollment_id)
                                                @Html.Hidden("classId", Model.class_id)
                                                <button type="submit" class="btn btn-outline-warning btn-sm"
                                                        onclick="return confirm('Bạn có chắc muốn vô hiệu hóa học sinh này không?');">
                                                    Vô hiệu hóa
                                                </button>
                                            }
                                        }
                                        @using (Html.BeginForm("RemoveStudent", "ClassManage", FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("enrollmentId", enrollment.enrollment_id)
                                            @Html.Hidden("classId", Model.class_id)
                                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Xóa enrollment sẽ xóa học sinh khỏi lớp. Bạn có chắc không?');">
                                                Xóa khỏi lớp
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="panel mt-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h2 class="h5 mb-1">Lịch học hàng tuần</h2>
                    <p class="text-muted mb-0">Các khung giờ lặp lại của lớp @Model.class_code.</p>
                </div>
                <button type="button" class="btn btn-primary btn-sm"
                        data-bs-toggle="modal" data-bs-target="#scheduleModal"
                        data-mode="add">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i>
                    Thêm lịch học
                </button>
            </div>

            @if (Model.ClassSchedules == null || !Model.ClassSchedules.Any())
            {
                <div class="alert alert-light border mb-0">
                    Chưa có lịch học nào cho lớp này.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ngày học</th>
                                <th>Khung giờ</th>
                                <th>Thời gian</th>
                                <th>Phòng</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model.ClassSchedules
                                .OrderBy(s => s.week_day)
                                .ThenBy(s => s.TimeSlot == null ? TimeSpan.MaxValue : s.TimeSlot.start_time))
                            {
                                <tr>
                                    <td>@schedule.week_day</td>
                                    <td>@(schedule.TimeSlot == null ? "-" : schedule.TimeSlot.slot_name)</td>
                                    <td>
                                        @(schedule.TimeSlot == null
                                            ? "-"
                                            : schedule.TimeSlot.start_time.ToString(@"hh\:mm") + " - " +
                                              schedule.TimeSlot.end_time.ToString(@"hh\:mm"))
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(schedule.room_name) ? "-" : schedule.room_name)</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm js-edit-schedule"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#scheduleModal"
                                                    data-id="@schedule.class_schedule_id"
                                                    data-class-id="@schedule.class_id"
                                                    data-week-day="@schedule.week_day"
                                                    data-time-slot-id="@schedule.time_slot_id"
                                                    data-room-name="@schedule.room_name">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                                Sửa
                                            </button>
                                             <button type="button"
                                                     class="btn btn-outline-danger btn-sm js-delete-schedule"
                                                     data-id="@schedule.class_schedule_id">
                                                     <i class="bi bi-trash3" aria-hidden="true"></i>
                                                     Xóa
                                             </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="panel mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="h5 mb-1">Buổi học</h2>
                    <p class="text-muted mb-0">Tự sinh theo lịch tuần và khoảng ngày của lớp.</p>
                </div>
                @using (Html.BeginForm("GenerateSessions", "ClassManage", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("classId", Model.class_id)
                    <button class="btn btn-primary btn-sm">Tạo/cập nhật buổi học</button>
                }
            </div>
            @if (Model.ClassSessions == null || !Model.ClassSessions.Any())
            {
                <div class="alert alert-light border mb-0">Chưa có buổi học nào.</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Ngày học</th><th>Khung giờ</th><th>Chủ đề</th><th class="text-end">Thao tác</th></tr></thead>
                    <tbody>
                    @foreach (var session in Model.ClassSessions.OrderBy(s => s.session_date).ThenBy(s => s.TimeSlot.start_time))
                    {
                        <tr>
                            <td>@session.session_date.ToString("dd/MM/yyyy")</td>
                            <td>@(session.TimeSlot == null ? "-" : session.TimeSlot.slot_name)</td>
                            <td>
                                @using (Html.BeginForm("UpdateSessionTopic", "ClassManage", FormMethod.Post, new { @class = "d-flex gap-2" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("sessionId", session.session_id)
                                    @Html.Hidden("classId", Model.class_id)
                                    <input type="text" name="topic" class="form-control form-control-sm"
                                           maxlength="300" value="@session.topic" placeholder="Nhập chủ đề" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">Lưu</button>
                                }
                            </td>
                            <td class="text-end">
                                @using (Html.BeginForm("DeleteSession", "ClassManage", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("sessionId", session.session_id)
                                    @Html.Hidden("classId", Model.class_id)
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Bạn có chắc muốn xóa buổi học này không?');">
                                        Xóa
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
        </section>

        <div class="modal fade" id="scheduleModal" tabindex="-1"
             aria-labelledby="scheduleModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    @using (Html.BeginForm("AddSchedule", "ClassManage",
                        FormMethod.Post, new { id = "scheduleForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="scheduleModalLabel">Thêm lịch học</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Đóng"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-danger d-none" id="scheduleFormError"></div>
                            <input type="hidden" id="scheduleId" name="class_schedule_id" />
                            <input type="hidden" id="scheduleClassId" name="class_id"
                                   value="@Model.class_id" />

                            <div class="mb-3">
                                <label for="scheduleWeekDay" class="form-label">Ngày học</label>
                                <select class="form-select" id="scheduleWeekDay" name="week_day" required>
                                    <option value="">-- Chọn ngày học --</option>
                                    <option value="Monday">Thứ hai</option>
                                    <option value="Tuesday">Thứ ba</option>
                                    <option value="Wednesday">Thứ tư</option>
                                    <option value="Thursday">Thứ năm</option>
                                    <option value="Friday">Thứ sáu</option>
                                    <option value="Saturday">Thứ bảy</option>
                                    <option value="Sunday">Chủ nhật</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="scheduleTimeSlot" class="form-label">Khung giờ</label>
                                @Html.DropDownList("time_slot_id",
                                    (SelectList)ViewBag.ScheduleTimeSlots,
                                    "-- Chọn khung giờ --",
                                    new { @class = "form-select", id = "scheduleTimeSlot", required = "required" })
                            </div>

                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save" aria-hidden="true"></i> Lưu lịch học
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    (function () {
        var form = document.getElementById("scheduleForm");
        var addButton = document.querySelector('[data-mode="add"]');
        var title = document.getElementById("scheduleModalLabel");
        var error = document.getElementById("scheduleFormError");
        var submit = form.querySelector('button[type="submit"]');

        function clearError() {
            error.textContent = "";
            error.classList.add("d-none");
        }

        addButton.addEventListener("click", function () {
            form.action = "@Url.Action("AddSchedule", "ClassManage")";
            title.textContent = "Thêm lịch học";
            document.getElementById("scheduleId").value = "";
            document.getElementById("scheduleClassId").value = "@Model.class_id";
            document.getElementById("scheduleWeekDay").value = "";
            document.getElementById("scheduleTimeSlot").value = "";
            clearError();
        });

        document.querySelectorAll(".js-edit-schedule").forEach(function (button) {
            button.addEventListener("click", function () {
                form.action = "@Url.Action("EditSchedule", "ClassManage")";
                title.textContent = "Sửa lịch học";
                document.getElementById("scheduleId").value = button.dataset.id;
                document.getElementById("scheduleClassId").value = button.dataset.classId;
                document.getElementById("scheduleWeekDay").value = button.dataset.weekDay;
                document.getElementById("scheduleTimeSlot").value = button.dataset.timeSlotId;
                clearError();
            });
        });

        document.querySelectorAll(".js-delete-schedule").forEach(function (button) {
            button.addEventListener("click", function () {
                if (!confirm("Bạn có chắc muốn xóa lịch học này không?")) {
                    return;
                }

                var data = new URLSearchParams();
                data.append("id", button.dataset.id);
                data.append(
                    "__RequestVerificationToken",
                    document.querySelector('input[name="__RequestVerificationToken"]').value);

                button.disabled = true;

                fetch('@Url.Action("DeleteSchedule", "ClassManage")', {
                    method: "POST",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest",
                        "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                    },
                    body: data
                })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error("HTTP " + response.status);
                    }
                    return response.json();
                })
                .then(function (result) {
                    if (!result.success) {
                        throw new Error(result.message || "Không thể xóa lịch học.");
                    }
                    window.location.href = result.redirectUrl;
                })
                .catch(function (requestError) {
                    alert(requestError.message || "Không thể xóa lịch học. Vui lòng thử lại.");
                    button.disabled = false;
                });
            });
        });

        form.addEventListener("submit", function (event) {
            event.preventDefault();
            clearError();
            submit.disabled = true;

            fetch(form.action, {
                method: "POST",
                headers: {
                    "X-Requested-With": "XMLHttpRequest",
                    "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                },
                body: new URLSearchParams(new FormData(form))
            })
            .then(function (response) {
                if (!response.ok) throw new Error("HTTP " + response.status);
                return response.json();
            })
            .then(function (result) {
                if (result.success) {
                    window.location.href = result.redirectUrl;
                    return;
                }

                error.textContent = (result.errors || ["Không thể lưu lịch học."]).join(" ");
                error.classList.remove("d-none");
                submit.disabled = false;
            })
            .catch(function () {
                error.textContent = "Không thể lưu lịch học. Vui lòng kiểm tra dữ liệu và thử lại.";
                error.classList.remove("d-none");
                submit.disabled = false;
            });
        });
    })();
</script>
