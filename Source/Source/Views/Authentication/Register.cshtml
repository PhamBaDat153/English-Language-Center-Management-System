@model Source.ViewModels.RegisterViewModel

@{
    ViewBag.Title = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_AuthenticationLayout.cshtml";
}

<div class="auth-shell">
    <div class="row g-0">
        <section class="col-lg-5 auth-brand-panel">
            <div>
                <a class="auth-logo" href="@Url.Action("Index", "Home")">
                    <i class="bi bi-mortarboard-fill"></i>NewGen
                </a>
                <h1>Bắt đầu hành trình mới</h1>
                <p>Tạo tài khoản học viên để đăng ký khóa học và theo dõi tiến độ học tập.</p>
            </div>
            <div class="auth-brand-features">
                <div class="auth-brand-feature"><i class="bi bi-check-circle-fill"></i><span>Đăng ký lớp học phù hợp</span></div>
                <div class="auth-brand-feature"><i class="bi bi-check-circle-fill"></i><span>Xem lịch học và tài liệu</span></div>
                <div class="auth-brand-feature"><i class="bi bi-check-circle-fill"></i><span>Theo dõi kết quả học tập</span></div>
            </div>
        </section>

        <section class="col-lg-7 auth-form-panel">
            <h2>Tạo tài khoản học viên</h2>
            <p class="auth-subtitle">Điền thông tin để tham gia NewGen English Center.</p>

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            @using (Html.BeginForm("Register", "Authentication", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    @Html.LabelFor(m => m.FullName, "Họ và tên", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Nguyễn Văn A", autocomplete = "name" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Username, "Tên đăng nhập", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "nguyen.van.a", autocomplete = "username" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                    <small class="form-text text-muted">Chỉ dùng chữ không dấu, số, dấu chấm, gạch dưới hoặc gạch ngang.</small>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, "Email", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "nguyen.van.a@example.com", autocomplete = "email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Password, "Mật khẩu", new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Tối thiểu 8 ký tự", autocomplete = "new-password", minlength = "8" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ConfirmPassword, "Xác nhận mật khẩu", new { @class = "form-label" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Nhập lại mật khẩu", autocomplete = "new-password", minlength = "8" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <button type="submit" class="btn btn-primary auth-submit w-100 mt-4">
                    <i class="bi bi-person-plus me-2"></i>Tạo tài khoản
                </button>
            }

            <p class="auth-footer">Bạn đã có tài khoản? <a href="@Url.Action("Login", "Authentication")">Đăng nhập</a></p>
        </section>
    </div>
</div>
