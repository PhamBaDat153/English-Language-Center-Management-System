<!-- START NAVBAR -->
<div id="navigation" class="navbar-light bg-faded site-navigation navigation2">
    <div class="container-fluid">
        <div class="row">
            <div class="col-20 align-self-center">
                <div class="site-logo">
                    <a href="@Url.Action("Index","Home")"><h1><strong>NewGen</strong></h1></a>
                </div>
            </div><!--- END Col -->

            <div class="col-60 d-flex">
                <nav id="main-menu">
                    <ul>
                        <li>
                            <a href="@Url.Action("Index","Home")">Trang chủ</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Courses", "Home")">Khóa học</a>
                        </li>
                        <li>
                            <a href="@Url.Action("About", "Home")">Về chúng tôi</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Contact", "Home")">Liên hệ</a>
                        </li>

                        @if (Request.IsAuthenticated)
                        {
                            if (User.IsInRole("Administrator"))
                            {
                                <li>
                                    <a href="@Url.Action("Index", "Dashboard")">
                                        Trang quản lý
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("Teacher"))
                            {
                                <li>
                                    <a href="@Url.Action("TeacherHome", "Dashboard")">
                                        Cổng giáo viên
                                    </a>
                                </li>
                            }

                            <!-- MỤC THÔNG BÁO CHO USER ĐÃ ĐĂNG NHẬP -->
                            <li>
                                <a href="@Url.Action("Index", "Notification")" class="position-relative">
                                    Thông báo
                                    <span id="mainMenuNotifBadge" class="badge rounded-pill bg-danger ms-1 d-none" style="font-size: 0.7rem;">0</span>
                                </a>
                            </li>
                        }
            </div><!--- END Col -->

            <div class="col-20 d-none d-xl-block text-end align-self-center">
                @if (Request.IsAuthenticated)
                {
                    <a href="@Url.Action("Index", "Profile")"
                       class="header-btn">
                        Hồ sơ cá nhân
                    </a>

                    using (Html.BeginForm(
                        "Logout",
                        "Authentication",
                        FormMethod.Post,
                        new { style = "display:inline;" }))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn_one border-0">
                            Đăng xuất
                        </button>
                    }
                }
                else
                {
                    <a href="@Url.Action("Login", "Authentication")"
                       class="header-btn">
                        Đăng nhập
                    </a>

                    <a href="@Url.Action("Register", "Authentication")"
                       class="btn_one">
                        Đăng ký
                    </a>
                }
            </div>
              
            </ul>
        </div><!--- END ROW -->
    </div><!--- END CONTAINER -->
</div><!-- END NAVBAR -->
