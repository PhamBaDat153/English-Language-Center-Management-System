@{ var currentTeacherAction = ViewContext.RouteData.Values["action"] as string; }
<div class="sidebar-backdrop" data-sidebar-close></div>

<aside class="admin-sidebar" id="adminSidebar" aria-label="Điều hướng giáo viên">
    <div class="sidebar-header">
        <a class="brand-mark" href="@Url.Action("TeacherHome", "Dashboard")" aria-label="NewGen Teacher">
            <span class="brand-icon"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i></span>
            <span class="brand-copy">
                <span class="brand-title">NewGen</span>
                <span class="brand-subtitle">Cổng giáo viên</span>
            </span>
        </a>
    </div>

    <nav class="sidebar-nav">
        <a class="@(currentTeacherAction == "TeacherHome" ? "nav-link active" : "nav-link")" href="@Url.Action("TeacherHome", "Dashboard")">
            <span class="nav-icon"><i class="bi bi-house-door-fill" aria-hidden="true"></i></span>
            <span class="nav-text">Trang chủ</span>
        </a>
        <a class="@(currentTeacherAction == "Classes" || currentTeacherAction == "ClassDetails" ? "nav-link active" : "nav-link")" href="@Url.Action("Classes", "Dashboard")">
            <span class="nav-icon"><i class="bi bi-easel2-fill" aria-hidden="true"></i></span>
            <span class="nav-text">Lớp giảng dạy</span>
        </a>
        <a class="@(currentTeacherAction == "Schedule" ? "nav-link active" : "nav-link")" href="@Url.Action("Schedule", "Dashboard")">
            <span class="nav-icon"><i class="bi bi-calendar2-week-fill" aria-hidden="true"></i></span>
            <span class="nav-text">Lịch giảng dạy</span>
        </a>
        <a class="@(currentTeacherAction == "Results" || currentTeacherAction == "SaveResults" ? "nav-link active" : "nav-link")" href="@Url.Action("Results", "Dashboard")">
            <span class="nav-icon"><i class="bi bi-journal-check" aria-hidden="true"></i></span>
            <span class="nav-text">Kết quả học tập</span>
        </a>
        <a class="nav-link" href="@Url.Action("Index", "Home")">
            <span class="nav-icon"><i class="bi bi-house-door-fill" aria-hidden="true"></i></span>
            <span class="nav-text">Về trang chính</span>
        </a>
    </nav>
</aside>

<div class="admin-main">
    <nav class="navbar admin-navbar navbar-expand bg-white">
        <div class="container-fluid px-3 px-lg-4">
            <button class="sidebar-toggle" type="button" data-sidebar-toggle
                    aria-controls="adminSidebar" aria-expanded="true" aria-label="Thu gọn menu">
                <span></span><span></span><span></span>
            </button>

    
            <div class="navbar-actions ms-auto">
                <button class="icon-button theme-toggle" type="button" data-theme-toggle
                        aria-label="Đổi giao diện sáng tối" title="Đổi giao diện sáng tối">
                    <i class="bi bi-moon-stars" data-theme-icon aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </nav>
