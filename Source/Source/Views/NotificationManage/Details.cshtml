@model Source.Models.Notification

@{
    ViewBag.Title = "Chi tiết & Gửi lại thông báo";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    string userName = Model.User != null ? Model.User.full_name : "N/A";
    string userEmail = Model.User != null ? Model.User.email : "N/A";
}

<style>
    /* Styling chữ màu trắng đồng bộ & tương phản cao */
    .text-custom-white {
        color: #ffffff !important;
    }

    .text-custom-light {
        color: #e2e8f0 !important; /* Trắng xám nhẹ cho thông tin phụ */
    }

    /* Khung thẻ tối màu giúp chữ trắng hiển thị nổi bật */
    .dark-card {
        background-color: #1e293b !important;
        border: 1px solid #334155 !important;
        border-radius: 12px;
    }

    .dark-card-header {
        background-color: #0f172a !important;
        border-bottom: 1px solid #334155 !important;
        border-top-left-radius: 12px !important;
        border-top-right-radius: 12px !important;
    }

    /* Khung nhập liệu Tiêu đề & Nội dung chữ màu trắng */
    .dark-input {
        background-color: #0f172a !important;
        color: #ffffff !important;
        border: 1px solid #475569 !important;
        border-radius: 8px;
    }

        .dark-input:focus {
            background-color: #0f172a !important;
            color: #ffffff !important;
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 0.25rem rgba(56, 189, 248, 0.25) !important;
        }

        .dark-input::placeholder {
            color: #94a3b8 !important;
        }
</style>

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4 py-4">

        <!-- Tiêu đề trang & Nút Quay lại -->
        <div class="page-heading d-flex justify-content-between align-items-center mb-4">
            <div class="page-heading-copy">
                <span class="page-icon">
                    <i class="bi bi-send-check-fill text-info" aria-hidden="true"></i>
                </span>
                <div>
                    <p class="eyebrow mb-1 text-custom-light">Quản lý thông báo</p>
                    <h1 class="h3 mb-1 text-custom-white fw-bold">Chi tiết & Gửi lại thông báo</h1>
                    <p class="text-custom-light mb-0">Chỉnh sửa thông tin và gửi lại thông báo đến người nhận.</p>
                </div>
            </div>

            <div class="heading-actions">
                <a href="~/NotificationManage" class="btn btn-outline-light btn-sm px-3">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>
        </div>

        <!-- Thông báo Alert lỗi nếu có -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
                <span>@TempData["ErrorMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-4">
            <!-- Cột trái: Thông tin người nhận & Lịch sử -->
            <div class="col-12 col-lg-4">
                <div class="card dark-card shadow-sm">
                    <div class="card-header dark-card-header py-3">
                        <h6 class="mb-0 fw-bold text-custom-white">
                            <i class="bi bi-person-badge text-info me-2"></i>Thông tin người nhận
                        </h6>
                    </div>
                    <div class="card-body p-3 p-md-4">
                        <div class="mb-3">
                            <label class="form-label text-custom-light small mb-1">Người nhận:</label>
                            <div class="fw-bold text-custom-white fs-6">@userName</div>
                            <small class="text-custom-light">@userEmail</small>
                        </div>

                        <hr class="my-3 border-secondary" />

                        <div class="mb-3">
                            <label class="form-label text-custom-light small mb-1">Ngày gửi lần đầu:</label>
                            <div class="fw-semibold text-custom-white">
                                <i class="bi bi-clock me-1 text-info"></i>@Model.created_at.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-custom-light small mb-1">Cập nhật lần cuối:</label>
                            <div class="fw-semibold text-custom-white">
                                <i class="bi bi-arrow-repeat me-1 text-warning"></i>@Model.updated_at.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label text-custom-light small mb-1">Trạng thái hiện tại:</label>
                            <div>
                                @if (Model.read_status == "Read")
                                {
                                    <span class="badge bg-success text-white px-2 py-1">Đã đọc</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-2 py-1">Chưa đọc</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Form Soạn nội dung & Nút Gửi lại -->
            <div class="col-12 col-lg-8">
                <div class="card dark-card shadow-sm">
                    <div class="card-header dark-card-header py-3">
                        <h6 class="mb-0 fw-bold text-custom-white">
                            <i class="bi bi-pencil-square text-info me-2"></i>Nội dung thông báo
                        </h6>
                    </div>

                    <div class="card-body p-3 p-md-4">
                        @using (Html.BeginForm("Resend", "NotificationManage", FormMethod.Post, new { id = "resendForm" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.notification_id)

                            <!-- Tiêu đề thông báo -->
                            <div class="mb-3">
                                <label for="title" class="form-label fw-bold text-custom-white">
                                    Tiêu đề thông báo <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       id="title"
                                       name="title"
                                       class="form-control dark-input"
                                       value="@Model.title"
                                       placeholder="Nhập tiêu đề..."
                                       required />
                            </div>

                            <!-- Nội dung thông báo -->
                            <div class="mb-4">
                                <label for="message" class="form-label fw-bold text-custom-white">
                                    Nội dung chi tiết <span class="text-danger">*</span>
                                </label>
                                <textarea id="message"
                                          name="message"
                                          class="form-control dark-input"
                                          rows="6"
                                          placeholder="Nhập nội dung thông báo..."
                                          required>@Model.message</textarea>
                            </div>

                            <!-- Thanh Thao tác ở cuối Form -->
                            <div class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top border-secondary">
                                <!-- Nút Quay lại / Hủy -->
                                <a href="~/NotificationManage" class="btn btn-outline-light px-4">
                                    Hủy
                                </a>

                                <!-- Nút Gửi lại (Chức năng như nút Gửi ở Create, chuyển hướng về Index sau khi xong) -->
                                <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                    <i class="bi bi-send me-1"></i> Gửi lại
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>