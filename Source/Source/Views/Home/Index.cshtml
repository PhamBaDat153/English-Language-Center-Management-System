@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using System.Globalization
@model Source.ViewModels.HomePageViewModel

<!-- START HOME -->
<section class="home_bg hb_height" style="background-image: url(/Resources/eduleb/eduleb/assets/img/bg/home-bg.jpg); background-size:cover; background-position: center center;">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-sm-12 col-xs-12">
                <div class="hero-text ht_top">
                    <h1><span>NewGen</span> Khai Mở Tiềm Năng Bứt Phá Tương Lai</h1>
                    <p>Hành trình chinh phục tiếng Anh chuẩn quốc tế cùng phương pháp giảng dạy hiện đại và lộ trình cá nhân hóa tại NewGen.</p>

                    <!-- THANH TÌM KIẾM KHÓA HỌC -->
                    <div class="hero-search-box mt-4 p-3 style-search-form" style="background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(8px); border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.3);">
                        <form action="@Url.Action("Courses", "Home")" method="get">
                            <div class="row g-2 align-items-center">
                                <!-- Nhập tên khóa học -->
                                <div class="col-md-5 col-12 mb-2 mb-md-0">
                                    <input type="text" name="searchName" class="form-control" placeholder="Nhập tên khóa học..." style="height: 45px; border-radius: 5px;" />
                                </div>
                                <!-- Chọn trình độ -->
                                <div class="col-md-4 col-12 mb-2 mb-md-0">
                                    <select name="level" class="form-control" style="height: 45px; border-radius: 5px;">
                                        <option value="">-- Tất cả trình độ --</option>
                                        <option value="Beginner">Beginner</option>
                                        <option value="Elementary">Elementary</option>
                                        <option value="Intermediate">Intermediate</option>
                                        <option value="UpperIntermediate">Upper Intermediate</option>
                                        <option value="Advanced">Advanced</option>
                                        <option value="IELTS">IELTS</option>
                                        <option value="TOEIC">TOEIC</option>
                                    </select>
                                </div>
                                <!-- Nút tìm kiếm -->
                                <div class="col-md-3 col-12">
                                    <button type="submit" class="btn btn-primary w-100" style="height: 45px; border-radius: 5px; font-weight: bold; background-color: #ff5e14; border: none;">
                                        <i class="ti-search"></i> Tìm kiếm
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!-- END THANH TÌM KIẾM -->

                </div>
            </div><!--- END COL -->
            <div class="col-lg-6 col-sm-12 col-xs-12">
                <div class="hero-text-img">
                    <img src="/Resources/eduleb/eduleb/assets/img/home-img2.png" class="img-fluid" alt="" />
                </div>
            </div><!--- END COL -->
        </div><!--- END ROW -->
    </div><!--- END CONTAINER -->
</section>
<!-- END HOME -->
<!-- START COUNTER -->
<section class="count_area counter_feature">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-folder sc_one"></span>
                    <h2 class="counter-num">@Model.courseCount</h2>
                    <p>Khóa học</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-check-box sc_three"></span>
                    <h2 class="counter-num">@Model.classCount</h2>
                    <p>Lớp học</p>
                </div>
            </div><!-- END COL -->
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-user sc_four"></span>
                    <h2 class="counter-num">@Model.activeTeacherCount</h2>
                    <p>Giáo viên</p>
                </div>
            </div><!-- END COL -->
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-user sc_two"></span>
                    <h2 class="counter-num">@Model.activeStudentCount</h2>
                    <p>Học viên hoạt động</p>
                </div>
            </div><!-- END COL -->
        </div><!--- END ROW -->
    </div><!--- END CONTAINER -->
</section>
<!-- END COUNTER -->
<!-- START CATEGORY -->
<section class="top_cat__area section-padding" style="background-image: url(/Resources/eduleb/eduleb/assets/img/bg/shape-1.png); background-size:cover; background-position: center center;">
    <div class="container">
        <div class="section-title text-center">
            <h2>Hành Trình Bứt Phá Cùng NewGen</h2>
            <p>Khám phá phương pháp học tiếng Anh hoàn toàn mới, giúp bạn làm chủ ngôn ngữ một cách tự nhiên, hiệu quả và nhanh chóng đạt được mục tiêu của mình.</p>
        </div>
        <div class="row">
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.2s" data-wow-offset="0">
                <div class="single_tp">
                    <span class="sc_one">01</span>
                    <h3>Đội Ngũ <br />Giảng Viên Giỏi</h3>
                    <p>Giảng viên bản xứ và Việt Nam giàu kinh nghiệm, đạt chứng chỉ quốc tế TESOL/CELTA.</p>
                </div>
            </div><!-- END COL -->
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.3s" data-wow-offset="0">
                <div class="single_tp">
                    <span class="sc_two">02</span>
                    <h3>Chất Lượng <br />Đào Tạo Chuẩn</h3>
                    <p>Giáo trình chuẩn quốc tế kết hợp lộ trình học tập được cá nhân hóa cho từng học viên.</p>
                </div>
            </div><!-- END COL -->
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.4s" data-wow-offset="0">
                <div class="single_tp">
                    <span class="sc_three">03</span>
                    <h3>Học Linh Hoạt <br />Online & Offline</h3>
                    <p>Lịch học đa dạng, kết hợp nền tảng học thông minh giúp bạn chủ động thời gian.</p>
                </div>
            </div><!-- END COL -->
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.4s" data-wow-offset="0">
                <div class="single_tp">
                    <span class="sc_four">04</span>
                    <h3>Đồng Hành <br />Trọn Đời</h3>
                    <p>Đội ngũ trợ giảng và cố vấn học tập luôn sẵn sàng hỗ trợ, đồng hành cùng bạn 24/7.</p>
                </div>
            </div><!-- END COL -->
        </div><!-- END ROW -->
    </div><!--- END CONTAINER -->
</section>
<!-- END CATEGORY -->
<!-- START ABOUT US -->
<section class="ab_area section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.2s" data-wow-offset="0">
                <div class="ab_img">
                    <img src="/Resources/eduleb/eduleb/assets/img/about1.png" class="img-fluid" alt="Về NewGen English">
                </div>
            </div><!--- END COL -->
            <div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s" data-wow-offset="0">
                <div class="ab_content">
                    <h2>NewGen – Tiên Phong Trong Đào Tạo Tiếng Anh Thế Hệ Mới</h2>
                    <p>Tại NewGen, chúng tôi mang đến phương pháp học tiếng Anh hiện đại, kết hợp giữa tư duy ngôn ngữ tự nhiên và ứng dụng công nghệ trong giảng dạy, giúp học viên phát triển toàn diện cả 4 kỹ năng.</p>
                    <p>Với chương trình học được cá nhân hóa tối đa, NewGen cam kết đồng hành cùng học viên trên con đường tự tin giao tiếp, chinh phục các chứng chỉ quốc tế và sẵn sàng vươn ra thế giới.</p>
                    <ul>
                        <li><span class="ti-check"></span> Tiếp cận kho tài liệu phong phú với <b>100%</b> bài giảng chuẩn quốc tế</li>
                        <li><span class="ti-check"></span> Các khóa học đa dạng từ Giao tiếp, IELTS đến Tiếng Anh cho người đi làm</li>
                        <li><span class="ti-check"></span> Đội ngũ giảng viên bản xứ và Việt Nam tâm huyết, giàu kinh nghiệm</li>
                    </ul>
                </div>
            </div><!--- END COL -->
        </div><!--- END ROW -->
    </div><!--- END CONTAINER -->
</section>
<!-- END ABOUT US -->
<!-- START COURSE -->
<section class="home-course-modern">
    <div class="container">
        <div class="course-section-heading">
            <div>
                <span class="course-eyebrow">
                    <i class="bi bi-book-half"></i>
                    Khóa học nổi bật
                </span>
                <h2>
                    Đồng hành cùng hơn
                    <strong>@Model.activeStudentCount</strong>
                    học viên tại NewGen
                </h2>
                <p>
                    Chọn lộ trình phù hợp để cải thiện tiếng Anh
                    và tiến gần hơn đến mục tiêu của bạn.
                </p>
            </div>

            <a href="@Url.Action("Courses", "Home")" class="course-view-all">
                Xem tất cả khóa học
                <i class="bi bi-arrow-up-right"></i>
            </a>
        </div>

        @if (Model.Courses == null || !Model.Courses.Any())
        {
            <div class="course-empty-state">
                <i class="bi bi-book"></i>
                <h3>Chưa có khóa học</h3>
                <p>Hiện chưa có khóa học nào đang được mở.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model.Courses)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <article class="course-card-modern">
                            <div class="course-card-image">
                                <img src="/Resources/eduleb/eduleb/assets/img/course/1.png"
                                     class="img-fluid"
                                     alt="@item.course_name" />
                                <span class="course-level-badge">@item.level</span>
                            </div>

                            <div class="course-card-body">
                                <div class="course-card-meta">
                                    <span><i class="bi bi-clock"></i>@item.duration_weeks tuần</span>
                                    <span><i class="bi bi-book"></i>NewGen</span>
                                </div>

                                <h3 class="course-card-title">
                                    <a href="@Url.Action("Details", "Home", new { id = item.course_id })">
                                        @item.course_name
                                    </a>
                                </h3>

                                <p class="course-card-description">
                                    @(string.IsNullOrWhiteSpace(item.description)
                                        ? "Lộ trình học tiếng Anh phù hợp với mục tiêu của bạn."
                                        : item.description)
                                </p>

                                <div class="course-card-footer">
                                    <div>
                                        <small>Học phí từ</small>
                                        <strong>@item.tuition_fee.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</strong>
                                    </div>
                                    <a class="course-detail-button"
                                       href="@Url.Action("Details", "Home", new { id = item.course_id })"
                                       aria-label="Xem chi tiết @item.course_name">
                                        Xem chi tiết
                                        <i class="ti-arrow-top-right" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>
<!-- END COURSE -->
<!-- START PROMO -->
<section class="ab_area section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s" data-wow-offset="0">
                <div class="ab_content">
                    <h2>Tại Sao Lựa Chọn Học Tiếng Anh Tại NewGen?</h2>
                    <p>NewGen tiên phong áp dụng phương pháp giảng dạy tương tác thế hệ mới, giúp học viên xóa bỏ rào cản tâm lý, tự tin phản xạ và làm chủ tiếng Anh một cách tự nhiên.</p>
                    <p>Dù mục tiêu của bạn là giao tiếp thành thạo, đạt điểm cao trong các kỳ thi quốc tế hay thăng tiến sự nghiệp, NewGen luôn xây dựng lộ trình tối ưu nhất dành cho bạn.</p>
                    <ul>
                        <li><span class="ti-check"></span> Lộ trình học cá nhân hóa theo trình độ và mục tiêu của từng học viên</li>
                        <li><span class="ti-check"></span> 100% Giảng viên có chứng chỉ sư phạm quốc tế TESOL / CELTA</li>
                        <li><span class="ti-check"></span> Cam kết đầu ra bằng hợp đồng và hỗ trợ học lại miễn phí</li>
                    </ul>
                    <a class="btn_one" href="@Url.Action("Courses", "Home")">Khám Phá Khóa Học <i class="ti-arrow-top-right"></i></a>
                </div>
            </div><!--- END COL -->
            <div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.2s" data-wow-offset="0">
                <div class="ab_img">
                    <img src="/Resources/eduleb/eduleb/assets/img/about3.png" class="img-fluid" alt="Lý do chọn NewGen English">
                    <div class="home_ps2">
                        <span class="ti-book"></span>
                        <h2>100%</h2>
                        <p>Cam kết đầu ra</p>
                    </div>
                </div>
            </div><!--- END COL -->
        </div><!--- END ROW -->
    </div><!--- END CONTAINER -->
</section>
<!-- END PROMO -->