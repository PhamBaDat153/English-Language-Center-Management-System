@{
    ViewBag.Title = "Khóa học";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Source.ViewModels.HomePageViewModel
@using System.Globalization

<!-- START COURSE -->
<section class="home-course-modern">
    <div class="container">
        <div class="course-section-heading">
            <div>
                <span class="course-eyebrow">
                    <i class="bi bi-book-half"></i>
                    Khóa học nổi bật
                </span>
                <h2>
                    Đồng hành cùng hơn
                    <strong>@Model.activeStudentCount</strong>
                    học viên tại NewGen
                </h2>
                <p>
                    Chọn lộ trình phù hợp để cải thiện tiếng Anh
                    và tiến gần hơn đến mục tiêu của bạn.
                </p>
            </div>

            <a href="@Url.Action("Courses", "Home")" class="course-view-all">
                Xem tất cả khóa học
                <i class="bi bi-arrow-up-right"></i>
            </a>
        </div>

        @if (Model.Courses == null || !Model.Courses.Any())
        {
            <div class="course-empty-state">
                <i class="bi bi-book"></i>
                <h3>Chưa có khóa học</h3>
                <p>Hiện chưa có khóa học nào đang được mở.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model.Courses)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <article class="course-card-modern">
                            <div class="course-card-image">
                                <img src="/Resources/eduleb/eduleb/assets/img/course/1.png"
                                     class="img-fluid"
                                     alt="@item.course_name" />
                                <span class="course-level-badge">@item.level</span>
                            </div>

                            <div class="course-card-body">
                                <div class="course-card-meta">
                                    <span><i class="bi bi-clock"></i>@item.duration_weeks tuần</span>
                                    <span><i class="bi bi-book"></i>NewGen</span>
                                </div>

                                <h3 class="course-card-title">
                                    <a href="@Url.Action("Details", "Home", new { id = item.course_id })">
                                        @item.course_name
                                    </a>
                                </h3>

                                <p class="course-card-description">
                                    @(string.IsNullOrWhiteSpace(item.description)
                                        ? "Lộ trình học tiếng Anh phù hợp với mục tiêu của bạn."
                                        : item.description)
                                </p>

                                <div class="course-card-footer">
                                    <div>
                                        <small>Học phí từ</small>
                                        <strong>@item.tuition_fee.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</strong>
                                    </div>
                                    <a class="course-detail-button"
                                       href="@Url.Action("Details", "Home", new { id = item.course_id })"
                                       aria-label="Xem chi tiết @item.course_name">
                                        Xem chi tiết
                                        <i class="ti-arrow-top-right" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <div class="d-flex flex-column flex-sm-row
                align-items-sm-center justify-content-center
                gap-3 mt-4">

                <nav aria-label="Phân trang khóa học">
                    <ul class="pagination pagination-sm mb-0">

                        @if (Model.CurrentPage <= 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">Trước</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action("Courses", "Home", new { page = Model.CurrentPage - 1 })">
                                    Trước
                                </a>
                            </li>
                        }

                        @for (int page = 1; page <= Model.TotalPages; page++)
                        {
                            <li class="page-item @(page == Model.CurrentPage ? "active" : "")">
                                @if (page == Model.CurrentPage)
                                {
                                    <span class="page-link" aria-current="page">@page</span>
                                }
                                else
                                {
                                    <a class="page-link"
                                       href="@Url.Action("Courses", "Home", new { page = page })">
                                        @page
                                    </a>
                                }
                            </li>
                        }

                        @if (Model.CurrentPage >= Model.TotalPages)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">Sau</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action("Courses", "Home", new { page = Model.CurrentPage + 1 })">
                                    Sau
                                </a>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        }
    </div><!--- END CONTAINER -->
</section>
<!-- END COURSE -->
