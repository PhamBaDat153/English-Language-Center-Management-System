@model Source.ViewModels.TeacherClassesViewModel
@using System.Linq
@{
    ViewBag.Title = "Lớp giảng dạy";
    Layout = "~/Views/Shared/_TeacherDashboardLayout.cshtml";
}
<main class="dashboard-content"><div class="container-fluid px-3 px-lg-4">
    <div class="page-heading"><div class="page-heading-copy"><span class="page-icon"><i class="bi bi-easel2" aria-hidden="true"></i></span><div><p class="eyebrow mb-1">Không gian giáo viên</p><h1 class="h3 mb-1">Lớp đang giảng dạy</h1><p class="text-muted mb-0">Danh sách lớp được phân công cho tài khoản của bạn.</p></div></div><a class="btn btn-outline-secondary" href="@Url.Action("TeacherHome", "Dashboard")">Về trang chủ</a></div>
    @if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div> }
    <section class="panel mt-3">
        @using (Html.BeginForm("Classes", "Dashboard", FormMethod.Get, new { @class = "row g-2 mb-3" }))
        {
            <div class="col-md-6"><input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Tìm mã lớp, khóa học, phòng..." /></div>
            <div class="col-auto"><button class="btn btn-primary" type="submit"><i class="bi bi-search me-1" aria-hidden="true"></i>Tìm kiếm</button></div>
            if (!string.IsNullOrWhiteSpace(Model.Search)) { <div class="col-auto"><a class="btn btn-outline-secondary" href="@Url.Action("Classes", "Dashboard")">Xóa lọc</a></div> }
        }
        @if (Model.Classes == null || !Model.Classes.Any()) { <div class="alert alert-light border mb-0">Bạn chưa được phân công lớp nào đang mở hoặc đang giảng dạy.</div> }
        else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Mã lớp</th><th>Khóa học</th><th>Phòng</th><th>Thời gian</th><th>Học viên</th><th>Trạng thái</th><th></th></tr></thead><tbody>
            @foreach (var item in Model.Classes) { <tr><td><strong>@item.ClassCode</strong></td><td>@item.CourseName <span class="text-muted">(@item.CourseCode)</span></td><td>@item.RoomName</td><td>@item.StartDate.ToString("dd/MM/yyyy") – @item.EndDate.ToString("dd/MM/yyyy")</td><td>@item.StudentCount</td><td><span class="badge @(item.ClassStatus == "InProgress" ? "text-bg-success" : "text-bg-primary")">@item.ClassStatusLabel</span></td><td><a class="btn btn-outline-primary btn-sm" href="@Url.Action("ClassDetails", "Dashboard", new { id = item.ClassId })">Xem học viên</a></td></tr> }
        </tbody></table></div> }
        @if ((int)ViewBag.TotalPages > 1) { <nav class="mt-3" aria-label="Phân trang lớp"><ul class="pagination justify-content-center mb-0">
            @for (var p = 1; p <= (int)ViewBag.TotalPages; p++) { <li class="page-item @(p == (int)ViewBag.CurrentPage ? "active" : "")"><a class="page-link" href="@Url.Action("Classes", "Dashboard", new { search = Model.Search, page = p })">@p</a></li> }
        </ul></nav> }
    </section>
</div></main>
