@model Source.ViewModels.TeacherDashboardViewModel
@using System.Linq
@{
    ViewBag.Title = "Trang chủ giáo viên";
    ViewBag.TeacherName = Model.TeacherName;
    Layout = "~/Views/Shared/_TeacherDashboardLayout.cshtml";
}

<main class="dashboard-content">
    <div class="container-fluid px-3 px-lg-4">
        <section class="page-heading">
            <div class="page-heading-copy">
                <span class="page-icon"><i class="bi bi-mortarboard" aria-hidden="true"></i></span>
                <div>
                    <p class="eyebrow mb-1">Teacher workspace</p>
                    <h1 class="h3 mb-1">Chào mừng trở lại, @Model.TeacherName</h1>
                    <p class="text-muted mb-0">Theo dõi lớp học, lịch giảng dạy và hoạt động trong tuần của bạn.</p>
                </div>
            </div>
            <div class="heading-actions">
                <a class="btn btn-primary" href="@Url.Action("Schedule", "Dashboard")"><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>Xem lịch giảng dạy</a>
            </div>
        </section>

        <section class="row g-3" aria-label="Tổng quan giảng dạy">
            <div class="col-12 col-sm-6 col-xl-3"><article class="metric-card metric-primary"><div class="metric-top"><span class="metric-label">Lớp đang phụ trách</span><span class="metric-icon"><i class="bi bi-easel2" aria-hidden="true"></i></span></div><div class="metric-value">@Model.ClassCount.ToString("00")</div><div class="metric-meta"><span>Lớp được phân công</span></div></article></div>
            <div class="col-12 col-sm-6 col-xl-3"><article class="metric-card metric-success"><div class="metric-top"><span class="metric-label">Học viên</span><span class="metric-icon"><i class="bi bi-people" aria-hidden="true"></i></span></div><div class="metric-value">@Model.StudentCount</div><div class="metric-meta"><span>Trong các lớp đang dạy</span></div></article></div>
            <div class="col-12 col-sm-6 col-xl-3"><article class="metric-card metric-warning"><div class="metric-top"><span class="metric-label">Buổi dạy tuần này</span><span class="metric-icon"><i class="bi bi-calendar2-week" aria-hidden="true"></i></span></div><div class="metric-value">@Model.SessionsThisWeek</div><div class="metric-meta"><span>Theo lịch các lớp đã phân công</span></div></article></div>
            <div class="col-12 col-sm-6 col-xl-3"><article class="metric-card metric-danger"><div class="metric-top"><span class="metric-label">Buổi cần điểm danh</span><span class="metric-icon"><i class="bi bi-check2-square" aria-hidden="true"></i></span></div><div class="metric-value">@Model.AttendanceToComplete.ToString("00")</div><div class="metric-meta"><span>Buổi đã diễn ra chưa đủ điểm danh</span></div></article></div>
        </section>

        <section class="row g-3 mt-1">
            <div class="col-12 col-xl-8">
                <article class="panel h-100">
                    <div class="panel-header"><div><p class="eyebrow mb-1">Buổi học tiếp theo</p><h2 class="h5 mb-0">@(Model.NextSession == null ? "Chưa có buổi học sắp tới" : "Lớp " + Model.NextSession.ClassCode)</h2></div>
                        @if (Model.NextSession != null) { <span class="badge text-bg-primary">@Model.NextSession.SessionDate.ToString("dd/MM/yyyy")</span> }
                    </div>
                    @if (Model.NextSession == null)
                    {
                        <div class="alert alert-light border mb-0">Hiện chưa có buổi học được tạo cho các lớp bạn phụ trách.</div>
                    }
                    else
                    {
                        <div class="d-flex align-items-start gap-3 mb-4"><span class="page-icon"><i class="bi bi-chat-square-text" aria-hidden="true"></i></span><div><h3 class="h4 mb-1">@Model.NextSession.CourseName</h3><p class="text-muted mb-3">@Model.NextSession.StudentCount học viên · @(Model.NextSession.Topic ?? "Chưa cập nhật chủ đề")</p><div class="d-flex flex-wrap gap-3 text-muted"><span><i class="bi bi-clock me-1" aria-hidden="true"></i>@Model.NextSession.StartTime.ToString(@"hh\:mm") – @Model.NextSession.EndTime.ToString(@"hh\:mm")</span><span><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>@Model.NextSession.RoomName</span><span><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@Model.NextSession.SessionDate.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</span></div></div></div>
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-top pt-3"><span class="text-muted"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>Lịch buổi học đã được cập nhật</span><a class="btn btn-outline-primary btn-sm" href="@Url.Action("TakeAttendance", "Dashboard", new { sessionId = Model.NextSession.SessionId })">Điểm danh <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
                    }
                </article>
            </div>
            <div class="col-12 col-xl-4">
                <article class="panel h-100"><div class="panel-header"><div><p class="eyebrow mb-1">Truy cập nhanh</p><h2 class="h5 mb-0">Công việc giảng dạy</h2></div></div>
                    <div class="d-grid gap-2"><a class="btn btn-outline-primary text-start" href="@Url.Action("Classes", "Dashboard")"><i class="bi bi-easel2 me-2" aria-hidden="true"></i>Xem lớp và học viên</a><a class="btn btn-outline-primary text-start" href="@Url.Action("Schedule", "Dashboard")"><i class="bi bi-calendar-week me-2" aria-hidden="true"></i>Xem lịch dạy</a><a class="btn btn-outline-primary text-start" href="@Url.Action("Results", "Dashboard")"><i class="bi bi-journal-check me-2" aria-hidden="true"></i>Xem và cập nhật điểm</a><a class="btn btn-outline-primary text-start" href="@Url.Action("Attendance", "Dashboard")"><i class="bi bi-person-check me-2" aria-hidden="true"></i>Điểm danh</a></div>
                </article>
            </div>
        </section>

        <section class="row g-3 mt-1">
            <div class="col-12 col-xl-8"><article class="panel"><div class="panel-header"><div><p class="eyebrow mb-1">Lịch sắp tới</p><h2 class="h5 mb-0">Các buổi dạy gần nhất</h2></div><a class="link-primary fw-semibold" href="@Url.Action("Schedule", "Dashboard")">Toàn bộ lịch <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
                @if (Model.UpcomingSessions != null && Model.UpcomingSessions.Any()) { <div class="activity-list">@foreach (var session in Model.UpcomingSessions) { <div class="activity-item"><span class="activity-dot bg-primary"></span><div class="d-flex flex-wrap align-items-center justify-content-between gap-2 w-100"><div><strong>@session.SessionDate.ToString("dd/MM/yyyy") · @session.StartTime.ToString(@"hh\:mm") – @session.EndTime.ToString(@"hh\:mm") · @session.ClassCode</strong><div>@session.CourseName <span class="text-muted">· @session.RoomName · @session.StudentCount học viên</span></div></div><a class="btn btn-outline-secondary btn-sm" href="@Url.Action("TakeAttendance", "Dashboard", new { sessionId = session.SessionId })">Điểm danh</a></div></div> }</div> }
                else if (Model.WeeklySchedules != null && Model.WeeklySchedules.Any()) { <div class="activity-list">@foreach (var schedule in Model.WeeklySchedules) { <div class="activity-item"><span class="activity-dot bg-primary"></span><div><strong>@schedule.WeekDay · @schedule.StartTime.ToString(@"hh\:mm") – @schedule.EndTime.ToString(@"hh\:mm") · @schedule.ClassCode</strong><div>@schedule.CourseName <span class="text-muted">· @schedule.RoomName</span></div></div></div> }</div><p class="text-muted small mb-0">Lịch buổi cụ thể chưa được tạo.</p> }
                else { <div class="alert alert-light border mb-0">Chưa có buổi dạy hoặc lịch tuần được khai báo.</div> }
            </article></div>

            <div class="col-12 col-xl-4" id="teacher-notices"><article class="panel h-100"><div class="panel-header"><div><p class="eyebrow mb-1">Cập nhật mới</p><h2 class="h5 mb-0">Thông báo</h2></div><span class="badge text-bg-danger">2</span></div><div class="activity-list"><div class="activity-item"><span class="activity-dot bg-primary"></span><div><strong>Lịch họp chuyên môn</strong><p class="mb-1">Thứ Sáu · 16:00 · Phòng họp tầng 2</p><small class="text-muted">Hôm qua</small></div></div><div class="activity-item"><span class="activity-dot bg-warning"></span><div><strong>Cập nhật giáo trình</strong><p class="mb-1">Tài liệu học kỳ mới đã sẵn sàng.</p><small class="text-muted">2 ngày trước</small></div></div></div><span class="text-muted small">Thông báo hiện là dữ liệu mẫu.</span></article></div>
        </section>

        <section class="panel mt-4" id="teacher-classes"><div class="panel-header"><div><p class="eyebrow mb-1">Tổng quan lớp</p><h2 class="h5 mb-0">Các lớp đang giảng dạy</h2></div><a class="link-primary fw-semibold" href="@Url.Action("Classes", "Dashboard")">Tất cả lớp <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
            @if (Model.Classes == null || !Model.Classes.Any()) { <div class="alert alert-light border mb-0">Bạn chưa được phân công lớp học nào.</div> }
            else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Lớp</th><th>Khóa học</th><th>Thời gian</th><th>Học viên</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var item in Model.Classes) { <tr><td><strong>@item.ClassCode</strong></td><td>@item.CourseName</td><td>@item.StartDate.ToString("dd/MM/yyyy") – @item.EndDate.ToString("dd/MM/yyyy")</td><td>@item.StudentCount</td><td><span class="badge text-bg-primary">@item.ClassStatusLabel</span></td><td><a class="btn btn-outline-primary btn-sm" href="@Url.Action("ClassDetails", "Dashboard", new { id = item.ClassId })">Chi tiết</a></td></tr> }</tbody></table></div> }
        </section>

        <section class="panel mt-4"><div class="panel-header"><div><p class="eyebrow mb-1">Theo dõi học tập</p><h2 class="h5 mb-0">Kết quả cần cập nhật</h2></div><a class="link-primary fw-semibold" href="@Url.Action("Results", "Dashboard")">Tất cả bài đánh giá <i class="bi bi-arrow-right" aria-hidden="true"></i></a></div>
            @if (Model.LatestAssessments == null || !Model.LatestAssessments.Any()) { <div class="alert alert-light border mb-0">Các lớp của bạn chưa có bài đánh giá.</div> }
            else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Lớp</th><th>Bài đánh giá</th><th>Ngày</th><th>Đã có điểm</th><th></th></tr></thead><tbody>@foreach (var assessment in Model.LatestAssessments) { <tr><td><strong>@assessment.ClassCode</strong><div class="text-muted small">@assessment.CourseName</div></td><td>@assessment.AssessmentName<div class="text-muted small">Tối đa @assessment.MaxScore điểm</div></td><td>@(assessment.AssessmentDate.HasValue ? assessment.AssessmentDate.Value.ToString("dd/MM/yyyy") : "-")</td><td><span class="badge @(assessment.ScoredCount >= assessment.StudentCount ? "text-bg-success" : "text-bg-warning")">@assessment.ScoredCount / @assessment.StudentCount</span></td><td><a class="btn btn-outline-primary btn-sm" href="@Url.Action("Results", "Dashboard", new { assessmentId = assessment.AssessmentId })">Xem / cập nhật</a></td></tr> }</tbody></table></div> }
        </section>
    </div>
</main>
