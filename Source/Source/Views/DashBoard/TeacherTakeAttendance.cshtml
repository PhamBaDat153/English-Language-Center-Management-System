@model Source.ViewModels.ClassAttendanceViewModel
@using System.Linq
@{
    ViewBag.Title = "Điểm danh lớp " + Model.class_code;
    Layout = "~/Views/Shared/_TeacherDashboardLayout.cshtml";
}
<main class="dashboard-content"><div class="container-fluid px-3 px-lg-4">
    <div class="page-heading"><div class="page-heading-copy"><span class="page-icon"><i class="bi bi-person-check" aria-hidden="true"></i></span><div><p class="eyebrow mb-1">Lớp @Model.class_code</p><h1 class="h3 mb-1">Điểm danh buổi học</h1><p class="text-muted mb-0">@Model.session_date.ToString("dd/MM/yyyy") · @(Model.time_slot_name ?? "-") · @(Model.topic ?? "Chưa có chủ đề")</p></div></div><a class="btn btn-outline-secondary" href="@Url.Action("Attendance", "Dashboard")">Quay lại</a></div>
    @using (Html.BeginForm("TakeAttendance", "Dashboard", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.session_id)
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger mt-3" })
        <section class="panel mt-3">
            @if (Model.Students == null || !Model.Students.Any())
            {
                <div class="alert alert-light border mb-0">Lớp chưa có học viên đang hoạt động trong buổi học này.</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Mã học viên</th><th>Họ tên</th><th>Trạng thái</th><th>Ghi chú</th></tr></thead><tbody>
                    @for (var i = 0; i < Model.Students.Count; i++)
                    {
                        <tr><td>@Model.Students[i].student_code</td><td><strong>@Model.Students[i].student_name</strong></td><td>@Html.HiddenFor(m => m.Students[i].enrollment_id)@Html.DropDownListFor(m => m.Students[i].attendance_status, new[] { new SelectListItem { Text = "-- Chọn trạng thái --", Value = "" }, new SelectListItem { Text = "Có mặt", Value = "Present" }, new SelectListItem { Text = "Vắng", Value = "Absent" }, new SelectListItem { Text = "Có phép", Value = "Excused" } }, new { @class = "form-select" })</td><td>@Html.TextBoxFor(m => m.Students[i].remarks, new { @class = "form-control", maxlength = "1000" })</td></tr>
                    }
                </tbody></table></div>
                <div class="d-flex gap-2 mt-3"><button type="submit" class="btn btn-primary"><i class="bi bi-save me-1" aria-hidden="true"></i>Lưu điểm danh</button><a class="btn btn-outline-secondary" href="@Url.Action("Attendance", "Dashboard")">Hủy</a></div>
            }
        </section>
    }
</div></main>
