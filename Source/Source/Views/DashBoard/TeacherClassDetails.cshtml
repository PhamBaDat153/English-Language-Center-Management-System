@model Source.ViewModels.TeacherClassDetailsViewModel
@using System.Linq
@{
    ViewBag.Title = "Chi tiết lớp " + Model.Class.ClassCode;
    Layout = "~/Views/Shared/_TeacherDashboardLayout.cshtml";
}
<main class="dashboard-content"><div class="container-fluid px-3 px-lg-4">
    <div class="page-heading"><div class="page-heading-copy"><span class="page-icon"><i class="bi bi-people" aria-hidden="true"></i></span><div><p class="eyebrow mb-1">@Model.Class.CourseName</p><h1 class="h3 mb-1">Lớp @Model.Class.ClassCode</h1><p class="text-muted mb-0">@Model.Class.StartDate.ToString("dd/MM/yyyy") – @Model.Class.EndDate.ToString("dd/MM/yyyy") · @Model.Class.RoomName</p></div></div><a class="btn btn-outline-secondary" href="@Url.Action("Classes", "Dashboard")">Quay lại danh sách</a></div>
    <section class="row g-3 mt-1"><div class="col-12 col-md-4"><article class="metric-card metric-primary"><div class="metric-top"><span class="metric-label">Học viên đang học</span><span class="metric-icon"><i class="bi bi-people" aria-hidden="true"></i></span></div><div class="metric-value">@Model.Students.Count</div></article></div><div class="col-12 col-md-4"><article class="metric-card metric-success"><div class="metric-top"><span class="metric-label">Bài đánh giá</span><span class="metric-icon"><i class="bi bi-journal-check" aria-hidden="true"></i></span></div><div class="metric-value">@Model.Assessments.Count</div></article></div><div class="col-12 col-md-4"><article class="metric-card metric-warning"><div class="metric-top"><span class="metric-label">Trạng thái lớp</span><span class="metric-icon"><i class="bi bi-info-circle" aria-hidden="true"></i></span></div><div class="metric-value h4">@Model.Class.ClassStatusLabel</div></article></div></section>
    <section class="panel mt-4"><div class="panel-header"><div><p class="eyebrow mb-1">Danh sách lớp</p><h2 class="h5 mb-0">Học viên</h2></div><a class="btn btn-outline-primary btn-sm" href="@Url.Action("Schedule", "Dashboard")">Lịch dạy</a></div>
        @if (Model.Students == null || !Model.Students.Any()) { <div class="alert alert-light border mb-0">Lớp hiện chưa có học viên đang hoạt động.</div> }
        else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Mã học viên</th><th>Họ tên</th><th>Email</th><th>Trạng thái đăng ký</th></tr></thead><tbody>@foreach (var student in Model.Students) { <tr><td>@student.StudentCode</td><td><strong>@student.StudentName</strong></td><td>@student.Email</td><td><span class="badge text-bg-light">@student.EnrollmentStatus</span></td></tr> }</tbody></table></div> }
    </section>
    <section class="panel mt-4"><div class="panel-header"><div><p class="eyebrow mb-1">Kết quả học tập</p><h2 class="h5 mb-0">Bài đánh giá của lớp</h2></div><a class="btn btn-outline-primary btn-sm" href="@Url.Action("Results", "Dashboard")">Tất cả kết quả</a></div>
        @if (Model.Assessments == null || !Model.Assessments.Any()) { <div class="alert alert-light border mb-0">Lớp chưa có bài đánh giá nào.</div> }
        else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Bài đánh giá</th><th>Loại</th><th>Ngày</th><th>Đã có điểm</th><th></th></tr></thead><tbody>@foreach (var assessment in Model.Assessments) { <tr><td><strong>@assessment.AssessmentName</strong><div class="text-muted small">Tối đa @assessment.MaxScore điểm</div></td><td>@assessment.AssessmentType</td><td>@(assessment.AssessmentDate.HasValue ? assessment.AssessmentDate.Value.ToString("dd/MM/yyyy") : "-")</td><td>@assessment.ScoredCount / @assessment.StudentCount</td><td><a class="btn btn-outline-primary btn-sm" href="@Url.Action("Results", "Dashboard", new { assessmentId = assessment.AssessmentId })">Xem / sửa điểm</a></td></tr> }</tbody></table></div> }
    </section>
</div></main>
